# Server
PORT=8080
NODE_ENV=development

# Database (PostgreSQL via Supabase or direct)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/nimbuscloud

# JWT Secrets (use long random strings in production)
JWT_SECRET=your-super-long-random-jwt-secret-here
REFRESH_SECRET=your-super-long-random-refresh-secret-here
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Supabase (if using Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=nimbuscloud-files

# AWS S3 (alternative to Supabase Storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET=nimbuscloud-bucket

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# File Limits
MAX_FILE_SIZE_MB=500
TRASH_RETENTION_DAYS=30
STORAGE_QUOTA_GB=15

# Email (optional, for share invitations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
